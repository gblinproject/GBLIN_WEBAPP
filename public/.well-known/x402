    },
    {
      "path": "/api/x402/catalog",
      "method": "GET",
      "price": "0.005",
      "description": "Call before your agent pays an x402 service it has not used recently: is that endpoint actually alive? Liveness of the ~200 most recently updated Bazaar listings, probed in rotation (each about every 36h): HTTP status, latency, last-OK time and consecutive failures per endpoint. Measurements only, no judgements; the probes never pay. Free aggregate view: gblin-mcp.gblin-mcp-worker.workers.dev/catalog"
    }
