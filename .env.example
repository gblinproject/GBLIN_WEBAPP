# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────────────────────
# GBLIN x402 API — paid endpoints under /api/x402/*
# ─────────────────────────────────────────────────────────────────────────────

# X402_PAY_TO_WALLET: 0x… address that receives USDC payments from agents.
# Every successful API call settles USDC directly to this wallet on Base mainnet.
# USE A DEDICATED WALLET — do not reuse the founder wallet.
X402_PAY_TO_WALLET="0xYOUR_DEDICATED_TREASURY_WALLET"

# Coinbase Developer Platform (CDP) credentials — required for the facilitator
# that verifies + settles x402 payments on Base mainnet. Sign up free at:
#   https://portal.cdp.coinbase.com
# Free tier: 1,000 settled tx / month. Then $0.001 / tx (taken from facilitator,
# not from your USDC).
CDP_API_KEY_ID="cdp-key-uuid-here"
CDP_API_KEY_SECRET="cdp-secret-here"

# Optional: override the default x402 facilitator URL (for testnet or self-hosted).
# Leave empty in production — defaults to Coinbase CDP for Base mainnet.
# Testnet example: https://x402.org/facilitator
# X402_FACILITATOR_URL=""

# Optional: override the default Base mainnet RPC. publicnode.com works without
# a key. For higher throughput use Alchemy or QuickNode.
# GBLIN_RPC_URL="https://base-mainnet.g.alchemy.com/v2/YOUR_KEY"

