# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────────────────────
# GBLIN x402 API — paid endpoints under /api/x402/*
# ─────────────────────────────────────────────────────────────────────────────

# X402_PAY_TO_WALLET: 0x… address that receives USDC payments from agents.
# Every successful API call settles USDC directly to this wallet on Base mainnet.
# USE A DEDICATED WALLET — do not reuse the founder wallet.
X402_PAY_TO_WALLET="0xYOUR_DEDICATED_TREASURY_WALLET"

# Coinbase Developer Platform (CDP) credentials — RECOMMENDED for production.
# When both are set, the middleware automatically routes verify/settle calls to
# the CDP facilitator (free tier: 1,000 tx/month, then ~$0.001/tx on the
# facilitator side — never charged to your USDC). Listing in the official
# Coinbase Bazaar is automatic.
# Sign up free: https://portal.cdp.coinbase.com
CDP_API_KEY_ID="cdp-key-uuid-here"
CDP_API_KEY_SECRET="cdp-secret-here"

# Optional override — use a custom facilitator URL when CDP keys are NOT set.
# When CDP keys are present this variable is ignored.
# Public free fallback (auto-used if CDP keys are missing): https://x402.org/facilitator
# Alternative: PayAI → https://facilitator.payai.network
# X402_FACILITATOR_URL=""

# Optional: override the default Base mainnet RPC. publicnode.com works without
# a key. For higher throughput use Alchemy or QuickNode.
# GBLIN_RPC_URL="https://base-mainnet.g.alchemy.com/v2/YOUR_KEY"

# ─────────────────────────────────────────────────────────────────────────────
# Agent stats — /api/agent-stats
# ─────────────────────────────────────────────────────────────────────────────
# ETHERSCAN_API_KEY: required to power the "AI Agents using GBLIN" KPI tile on
# the home page. The endpoint queries Etherscan V2 multichain (chainid 8453 =
# Base) to count USDC Transfer events to the x402 fee wallet. Free key:
# https://etherscan.io/myapikey  (the same key works for every chain).
ETHERSCAN_API_KEY="your-etherscan-key"

