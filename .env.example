# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────────────────────
# GBLIN x402 API — paid endpoints under /api/x402/*
# ─────────────────────────────────────────────────────────────────────────────

# X402_PAY_TO_WALLET: 0x… address that receives USDC payments from agents.
# Every successful API call settles USDC directly to this wallet on Base mainnet.
# USE A DEDICATED WALLET — do not reuse the founder wallet.
X402_PAY_TO_WALLET="0xYOUR_DEDICATED_TREASURY_WALLET"

# x402 v2 facilitator URL — verifies signatures + settles USDC on Base mainnet.
# Default (when unset): https://x402.org/facilitator (public, free, supports
# Base mainnet under x402 v2).
# Alternative production facilitators:
#   • Coinbase CDP : https://api.cdp.coinbase.com/platform/v2/x402
#                    (requires CDP_API_KEY_ID + CDP_API_KEY_SECRET headers —
#                    sign up at https://portal.cdp.coinbase.com)
#   • PayAI        : https://facilitator.payai.network
# X402_FACILITATOR_URL="https://x402.org/facilitator"

# Optional: override the default Base mainnet RPC. publicnode.com works without
# a key. For higher throughput use Alchemy or QuickNode.
# GBLIN_RPC_URL="https://base-mainnet.g.alchemy.com/v2/YOUR_KEY"

