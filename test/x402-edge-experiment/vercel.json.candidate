{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/rebalance",
      "schedule": "0 8 * * 1"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/x402/attestation",
      "missing": [
        {
          "type": "header",
          "key": "x-payment"
        },
        {
          "type": "header",
          "key": "payment-signature"
        }
      ],
      "status": 402,
      "dest": "/x402-static/attestation.json",
      "headers": {
        "content-type": "application/json",
        "payment-required": ""
      }
    }
  ]
}
